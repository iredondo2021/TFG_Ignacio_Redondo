def build_triplet_indices(i, n_slices):
    """
    Para slice i, devuelve índices [prev, center, next]
    usando padding por repetición en los bordes.
    """
    prev_i = max(i - 1, 0)
    next_i = min(i + 1, n_slices - 1)
    return prev_i, i, next_i

